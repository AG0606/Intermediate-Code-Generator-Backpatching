digraph ControlFlowGraph {
    node [shape=record, fontname="Consolas, monospace", style=filled];
    edge [fontname="Consolas, monospace", fontsize=10];

    B0 [fillcolor="#e8f4f8", color="#3498db", label="{B0 (Quads 0..0)|0: if a > 0 goto 2\l}"];
    B1 [fillcolor="#e8f4f8", color="#3498db", label="{B1 (Quads 1..1)|1: goto 18\l}"];
    B2 [fillcolor="#e8f4f8", color="#3498db", label="{B2 (Quads 2..2)|2: if b < 10 goto 4\l}"];
    B3 [fillcolor="#e8f4f8", color="#3498db", label="{B3 (Quads 3..3)|3: goto 20\l}"];
    B4 [fillcolor="#e8f4f8", color="#3498db", label="{B4 (Quads 4..4)|4: i = 0\l}"];
    B5 [fillcolor="#e8f4f8", color="#3498db", label="{B5 (Quads 5..5)|5: if i < 5 goto 10\l}"];
    B6 [fillcolor="#e8f4f8", color="#3498db", label="{B6 (Quads 6..6)|6: goto 15\l}"];
    B7 [fillcolor="#e8f4f8", color="#3498db", label="{B7 (Quads 7..9)|7: t1 = i + 1\l8: i = t1\l9: goto 5\l}"];
    B8 [fillcolor="#e8f4f8", color="#3498db", label="{B8 (Quads 10..10)|10: if i == 2 goto 15\l}"];
    B9 [fillcolor="#e8f4f8", color="#3498db", label="{B9 (Quads 11..11)|11: goto 12\l}"];
    B10 [fillcolor="#e8f4f8", color="#3498db", label="{B10 (Quads 12..14)|12: t2 = x + i\l13: x = t2\l14: goto 7\l}"];
    B11 [fillcolor="#e8f4f8", color="#3498db", label="{B11 (Quads 15..17)|15: t3 = b + 1\l16: b = t3\l17: goto 2\l}"];
    B12 [fillcolor="#e8f4f8", color="#3498db", label="{B12 (Quads 18..19)|18: t4 = y - 1\l19: y = t4\l}"];
    B13 [fillcolor="#e8f4f8", color="#3498db", label="{B13 (Quads 20..20)|20: end\l}"];

    B0 -> B1 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B0 -> B2 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B1 -> B12 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B2 -> B3 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B2 -> B4 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B3 -> B13 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B4 -> B5 [label="fallthrough", color="#2980b9", fontcolor="#2980b9"];
    B5 -> B6 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B5 -> B8 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B6 -> B11 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B7 -> B5 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B8 -> B9 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B8 -> B11 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B9 -> B10 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B10 -> B7 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B11 -> B2 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B12 -> B13 [label="fallthrough", color="#2980b9", fontcolor="#2980b9"];
}
