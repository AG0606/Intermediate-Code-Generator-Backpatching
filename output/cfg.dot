digraph ControlFlowGraph {
    node [shape=record, fontname="Consolas, monospace", style=filled];
    edge [fontname="Consolas, monospace", fontsize=10];

    B0 [fillcolor="#e8f4f8", color="#3498db", label="{B0 (Quads 0..1)|0: func_begin helper\l1: if a > 100 goto 3\l}"];
    B1 [fillcolor="#e8f4f8", color="#3498db", label="{B1 (Quads 2..2)|2: goto 4\l}"];
    B2 [fillcolor="#e8f4f8", color="#3498db", label="{B2 (Quads 3..3)|3: return a\l}"];
    B3 [fillcolor="#e8f4f8", color="#3498db", label="{B3 (Quads 4..5)|4: t1 = a * 2\l5: return t1\l}"];
    B4 [fillcolor="#f8d7da", color="#e74c3c", label="{B4 (Quads 6..6) [DEAD]|6: func_end helper\l}"];
    B5 [fillcolor="#e8f4f8", color="#3498db", label="{B5 (Quads 7..11)|7: func_begin main\l8: x = 10\l9: y = 20\l10: total = 0\l11: i = 0\l}"];
    B6 [fillcolor="#e8f4f8", color="#3498db", label="{B6 (Quads 12..12)|12: if i < 5 goto 18\l}"];
    B7 [fillcolor="#e8f4f8", color="#3498db", label="{B7 (Quads 13..13)|13: goto 24\l}"];
    B8 [fillcolor="#f8d7da", color="#e74c3c", label="{B8 (Quads 14..14) [DEAD]|14: goto 18\l}"];
    B9 [fillcolor="#e8f4f8", color="#3498db", label="{B9 (Quads 15..17)|15: t2 = i + 1\l16: i = t2\l17: goto 12\l}"];
    B10 [fillcolor="#e8f4f8", color="#3498db", label="{B10 (Quads 18..23)|18: x_s5 = 100\l19: t3 = total + x_s5\l20: total = t3\l21: t4 = total + x\l22: total = t4\l23: goto 15\l}"];
    B11 [fillcolor="#e8f4f8", color="#3498db", label="{B11 (Quads 24..27)|24: param total\l25: t5 = call helper, 1\l26: result = t5\l27: return result\l}"];
    B12 [fillcolor="#f8d7da", color="#e74c3c", label="{B12 (Quads 28..29) [DEAD]|28: func_end main\l29: end\l}"];

    B0 -> B1 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B0 -> B2 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B1 -> B3 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B4 -> B5 [label="fallthrough", color="#2980b9", fontcolor="#2980b9"];
    B5 -> B6 [label="fallthrough", color="#2980b9", fontcolor="#2980b9"];
    B6 -> B7 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B6 -> B10 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B7 -> B11 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B8 -> B10 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B9 -> B6 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B10 -> B9 [label="jump", color="#f39c12", fontcolor="#f39c12"];
}
