digraph ControlFlowGraph {
    node [shape=record, fontname="Consolas, monospace", style=filled];
    edge [fontname="Consolas, monospace", fontsize=10];

    B0 [fillcolor="#e8f4f8", color="#3498db", label="{B0 (Quads 0..1)|0: func_begin helper\l1: if a > 100 goto 3\l}"];
    B1 [fillcolor="#e8f4f8", color="#3498db", label="{B1 (Quads 2..2)|2: goto 4\l}"];
    B2 [fillcolor="#e8f4f8", color="#3498db", label="{B2 (Quads 3..3)|3: return a\l}"];
    B3 [fillcolor="#e8f4f8", color="#3498db", label="{B3 (Quads 4..5)|4: t1 = a * 2\l5: return t1\l}"];
    B4 [fillcolor="#e8f4f8", color="#3498db", label="{B4 (Quads 6..10)|6: func_begin main\l7: x = 10\l8: y = 20\l9: total = 0\l10: i = 0\l}"];
    B5 [fillcolor="#e8f4f8", color="#3498db", label="{B5 (Quads 11..11)|11: if i < 5 goto 16\l}"];
    B6 [fillcolor="#e8f4f8", color="#3498db", label="{B6 (Quads 12..12)|12: goto 22\l}"];
    B7 [fillcolor="#e8f4f8", color="#3498db", label="{B7 (Quads 13..15)|13: t2 = i + 1\l14: i = t2\l15: goto 11\l}"];
    B8 [fillcolor="#e8f4f8", color="#3498db", label="{B8 (Quads 16..21)|16: x_s5 = 100\l17: t3 = total + x_s5\l18: total = t3\l19: t4 = total + x\l20: total = t4\l21: goto 13\l}"];
    B9 [fillcolor="#e8f4f8", color="#3498db", label="{B9 (Quads 22..25)|22: param total\l23: t5 = call helper, 1\l24: result = t5\l25: return result\l}"];

    B0 -> B1 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B0 -> B2 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B1 -> B3 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B4 -> B5 [label="fallthrough", color="#2980b9", fontcolor="#2980b9"];
    B5 -> B6 [label="false", color="#c0392b", fontcolor="#c0392b"];
    B5 -> B8 [label="true", color="#27ae60", fontcolor="#27ae60"];
    B6 -> B9 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B7 -> B5 [label="jump", color="#f39c12", fontcolor="#f39c12"];
    B8 -> B7 [label="jump", color="#f39c12", fontcolor="#f39c12"];
}
